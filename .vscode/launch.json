{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ivs_sessions_browser (module)",
      "type": "debugpy",
      "request": "launch",
      "module": "ivs_sessions_browser",
      "args":["--scope", "master", "--filters", "stations:Ns|Nn;start:2026-04"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "run_sessions_browser.py (script)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_sessions_browser.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

